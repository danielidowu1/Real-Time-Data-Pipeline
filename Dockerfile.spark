FROM apache/spark:3.5.0

USER root

# Install netcat for network checking utilities
RUN apt-get update && apt-get install -y netcat-openbsd && rm -rf /var/lib/apt/lists/*

# Pre-download the exact required JAR files directly into Spark's internal folder
ADD --chmod=644 https://maven.org /opt/spark/jars/
ADD --chmod=644 https://maven.org /opt/spark/jars/
ADD --chmod=644 https://maven.org /opt/spark/jars/

USER spark